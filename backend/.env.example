# Kunci AI (wajib)
KENARI_API_KEY=

# Port server (opsional, default 3102)
PORT=3102

# Supabase (wajib untuk login + database + job paket)
# Diisi di /opt/modulajar/.env di VPS, JANGAN di-commit dengan nilai asli
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Kuota mingguan dokumen per user biasa (admin tidak dibatasi). Reset tiap Minggu jam 15:00 WIB.
KUOTA_MINGGUAN=20

# Email admin (tanpa batas kuota), pisahkan dengan koma bila lebih dari satu
ADMIN_EMAILS=faruq.blogger@gmail.com
